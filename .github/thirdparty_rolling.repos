repositories:
  ThirdParty/EasyNavigation:
    type: git
    url: https://github.com/EasyNavigation/EasyNavigation.git
    version: rolling
  ThirdParty/yaets:
    type: git
    url: https://github.com/fmrico/yaets.git
    version: rolling
  ThirdParty/NavMap:
    type: git
    url: https://github.com/EasyNavigation/NavMap.git
    version: rolling
  # robot_localization: ros-rolling-robot-localization is not in the main
  # repository yet, and upstream rolling-devel lacks an #include <numeric>
  # (cra-ros-pkg/robot_localization#986). Back to upstream once merged.
  ThirdParty/robot_localization:
    type: git
    url: https://github.com/EasyNavigation/robot_localization.git
    version: include_numeric
