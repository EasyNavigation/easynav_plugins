<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>easynav_bigmap_maps_manager</name>
  <version>0.5.1</version>
  <description>Easy Navigation: BigMap maps manager. A map for areas too big to plan on at full resolution: a NavMap whose triangles are fine around the robot and coarse far away (dynamic level of detail of a DEM or of a NavMap with several floors).</description>
  <maintainer email="josemiguel.guerrero@urjc.es">José Miguel Guerrero</maintainer>
  <license>Apache-2.0</license>
  <author email="josemiguel.guerrero@urjc.es">José Miguel Guerrero</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2</depend>
  <depend>nav_msgs</depend>
  <depend>std_srvs</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>pluginlib</depend>
  <depend>easynav_common</depend>
  <depend>easynav_core</depend>
  <depend>easynav_sensors</depend>
  <depend>easynav_navmap_maps_manager</depend>
  <depend>navmap_core</depend>
  <depend>navmap_ros</depend>
  <depend>navmap_ros_interfaces</depend>
  <depend>std_msgs</depend>
  <depend>eigen</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
